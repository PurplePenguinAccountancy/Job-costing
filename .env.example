# Superuser connection (used only for running migrations)
MIGRATIONS_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/job_costing_dev

# Application connection — a least-privilege role subject to Postgres row-level
# security. The app must always connect as this role, never as postgres.
DATABASE_URL=postgres://app_user:password@127.0.0.1:5432/job_costing_dev

# Xero custom connection (client_credentials grant, single org) — created at
# developer.xero.com. Dev-level for now, not yet stored per-tenant in the DB.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Azure Document Intelligence (prebuilt invoice model) — Addendum 2.G,
# provisional pending a pilot bake-off against AWS Textract. Leave unset to
# fall back to the mock extraction adapter for local dev.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
