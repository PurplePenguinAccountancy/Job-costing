# Superuser connection (used only for running migrations)
MIGRATIONS_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/job_costing_dev

# Application connection — a least-privilege role subject to Postgres row-level
# security. The app must always connect as this role, never as postgres.
DATABASE_URL=postgres://app_user:password@127.0.0.1:5432/job_costing_dev
